---
import { getEntry, render } from 'astro:content';
import { Breadcrumbs } from '@components/breadcrumbs';
import { ImageModal } from '@components/posts';
import { ProjectHeader, ProjectHero } from '@components/projects';
import Base from '@layouts/base.astro';
import { getProjects } from '@utils/content';
import { formatDate } from '@utils/date';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const categoryLabel =
  project.data.category === 'professional' ? 'Professional' : 'Personal';

const relatedPosts = (
  await Promise.all(
    (project.data.posts ?? []).map((id) => getEntry('posts', id))
  )
).filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Base
  pageTitle={`${project.data.title} :: Ross Brandon`}
  description={project.data.description}
>
  <main class="pdp-wrap">
    <Breadcrumbs
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Projects', href: '/projects' },
        {
          label: categoryLabel,
          href: `/projects?category=${project.data.category}`,
        },
        { label: project.data.title },
      ]}
    />

    <div class="pdp-hero">
      <ProjectHero project={project} />
      <ProjectHeader project={project} />
    </div>

    <article class="pdp-prose prose">
      <Content />
    </article>
    <ImageModal />

    {
      relatedPosts.length > 0 && (
        <section class="pdp-related" aria-labelledby="related-writing-heading">
          <h2 id="related-writing-heading">Related Writing</h2>
          <ul>
            {relatedPosts.map((post) => (
              <li>
                <a href={`/posts/${post.id}`} data-astro-prefetch>
                  <span class="title">{post.data.title}</span>
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

<style>
  .pdp-wrap {
    max-width: var(--container-max);
    width: 100%;
    margin: 0 auto;
    padding: var(--space-8) var(--space-8) var(--space-10);
    text-align: left;
  }
  @media (max-width: 760px) {
    .pdp-wrap {
      padding: var(--space-6) var(--space-5) var(--space-8);
    }
  }

  .pdp-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    margin-bottom: var(--space-10);
  }
  @media (max-width: 960px) {
    .pdp-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .pdp-prose {
    max-width: 100%;
    margin: 0 0 var(--space-10);
  }
  .pdp-prose :global(h2) {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }
  .pdp-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .pdp-prose :global(h3) {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-top: var(--space-8);
    margin-bottom: var(--space-2);
  }
  .pdp-prose :global(p) {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }
  .pdp-prose :global(ul) {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    padding-left: var(--space-5);
    margin-bottom: var(--space-4);
  }
  .pdp-prose :global(ul li) {
    margin-bottom: var(--space-2);
  }
  .pdp-prose :global(ul li::marker) {
    color: var(--accent);
  }
  .pdp-prose :global(strong) {
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
  }

  .pdp-related {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-subtle);
  }
  .pdp-related h2 {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-4);
  }
  .pdp-related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .pdp-related a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }
  .pdp-related a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .pdp-related .title {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }
  .pdp-related time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
</style>
