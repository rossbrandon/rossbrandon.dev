---
import { ReadingTime } from '@components/posts';

import Base from './base.astro';

const {
  frontmatter,
  title: propTitle,
  pageTitle: propPageTitle,
  description: propDescription,
  ogType,
  publishedDate,
  readingTime,
} = Astro.props;
const title = propTitle ?? frontmatter?.title;
const pageTitle = propPageTitle ?? frontmatter?.pageTitle ?? title;
const imageAlign =
  frontmatter?.imageAlign === 'left' || frontmatter?.imageAlign === 'right'
    ? frontmatter.imageAlign
    : 'center';
const mainClass = `page-content image-align-${imageAlign}`;
const description = propDescription ?? frontmatter?.description;
---

<Base
  pageTitle={pageTitle}
  description={description}
  ogType={ogType}
  publishedDate={publishedDate}
>
  <slot name="head" slot="head" />
  <main class={mainClass}>
    <article>
      <header>
        {
          readingTime && (
            <p class="reading-time">
              <ReadingTime readingTime={readingTime} />
            </p>
          )
        }
        <h1>{title}</h1>
      </header>
      <slot />
    </article>
  </main>
</Base>

<style>
  .page-content {
    width: var(--container-prose);
    max-width: 100%;
    margin: 0 auto;
    padding-top: 3rem;
    padding-bottom: 3rem;
    text-align: left;

    @media (max-width: 684px) {
      width: 100%;
      padding: 1.5rem 2rem;
    }
  }

  .page-content :global(img) {
    margin: 2rem auto;
  }

  .page-content.image-align-left
    :global(img:not(.left):not(.center):not(.right)) {
    margin-left: 0;
    margin-right: auto;
  }

  .page-content.image-align-right
    :global(img:not(.left):not(.center):not(.right)) {
    margin-left: auto;
    margin-right: 0;
  }

  article {
    line-height: 1.6;
  }

  header {
    margin-bottom: 2rem;
    text-align: left;
  }

  h1 {
    font-size: 2.5rem;

    @media (max-width: 684px) {
      font-size: 2rem;
    }
  }

  time {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }
</style>
