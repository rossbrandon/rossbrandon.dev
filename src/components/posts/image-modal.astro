<div
  id="image-modal"
  class="image-modal"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="image-modal-caption"
>
  <div class="modal-backdrop"></div>
  <div class="modal-content">
    <button type="button" class="modal-close" aria-label="Close image modal"
      >&times;</button
    >
    <button
      type="button"
      class="modal-nav modal-nav-prev"
      aria-label="Previous image"
    >
      &#8249;
    </button>
    <button
      type="button"
      class="modal-nav modal-nav-next"
      aria-label="Next image"
    >
      &#8250;
    </button>
    <img src="" alt="" class="modal-image" />
    <div id="image-modal-caption" class="modal-caption"></div>
  </div>
</div>

<script>
  function initImageModal() {
    const modal = document.getElementById('image-modal');
    if (
      !(modal instanceof HTMLElement) ||
      modal.dataset.initialized === 'true'
    ) {
      return;
    }

    const modalImage = modal.querySelector<HTMLImageElement>('.modal-image');
    const modalCaption = modal.querySelector<HTMLElement>('.modal-caption');
    const closeButton = modal.querySelector<HTMLButtonElement>('.modal-close');
    const prevButton =
      modal.querySelector<HTMLButtonElement>('.modal-nav-prev');
    const nextButton =
      modal.querySelector<HTMLButtonElement>('.modal-nav-next');
    const backdrop = modal.querySelector<HTMLDivElement>('.modal-backdrop');

    if (
      !modalImage ||
      !modalCaption ||
      !closeButton ||
      !prevButton ||
      !nextButton ||
      !backdrop
    ) {
      return;
    }

    modal.dataset.initialized = 'true';

    const articleImages = Array.from(
      document.querySelectorAll<HTMLImageElement>('article img')
    ).filter((img) => !img.closest('#image-modal'));

    if (articleImages.length === 0) {
      return;
    }

    let scrollY = 0;
    let currentImageIndex = 0;
    let lastFocusedElement: HTMLElement | null = null;
    let shouldRestoreFocus = false;

    const isModalOpen = () => modal.classList.contains('active');

    const lockBodyScroll = () => {
      scrollY = window.scrollY;
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    };

    const unlockBodyScroll = () => {
      const html = document.documentElement;
      const previousScrollBehavior = html.style.scrollBehavior;
      html.style.scrollBehavior = 'auto';

      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      window.scrollTo({ top: scrollY, left: 0, behavior: 'auto' });

      requestAnimationFrame(() => {
        html.style.scrollBehavior = previousScrollBehavior;
      });
    };

    const getFocusableElements = () => {
      const focusableSelectors = [
        'a[href]',
        'button:not([disabled])',
        'input:not([disabled])',
        'select:not([disabled])',
        'textarea:not([disabled])',
        '[tabindex]:not([tabindex="-1"])',
      ].join(', ');

      return Array.from(
        modal.querySelectorAll<HTMLElement>(focusableSelectors)
      ).filter(
        (element) =>
          !element.hasAttribute('hidden') && element.getClientRects().length > 0
      );
    };

    const updateNavVisibility = () => {
      const hasMultipleImages = articleImages.length > 1;
      prevButton.hidden = !hasMultipleImages;
      nextButton.hidden = !hasMultipleImages;
    };

    const setModalImage = (imageElement: HTMLImageElement) => {
      modalImage.src = imageElement.currentSrc || imageElement.src;
      modalImage.alt = imageElement.alt;
      modalCaption.textContent = imageElement.alt || '';
    };

    const showImageAtIndex = (index: number) => {
      currentImageIndex = (index + articleImages.length) % articleImages.length;
      setModalImage(articleImages[currentImageIndex]);
    };

    const openModal = (
      imageElement: HTMLImageElement,
      restoreFocusOnClose: boolean
    ) => {
      const imageIndex = articleImages.indexOf(imageElement);
      if (imageIndex < 0) {
        return;
      }

      shouldRestoreFocus = restoreFocusOnClose;
      lastFocusedElement = restoreFocusOnClose
        ? (document.activeElement as HTMLElement)
        : null;

      updateNavVisibility();
      showImageAtIndex(imageIndex);

      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('active');
      lockBodyScroll();
      closeButton.focus({ preventScroll: true });
    };

    const closeModal = () => {
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('active');
      unlockBodyScroll();
      modalImage.removeAttribute('src');
      modalCaption.textContent = '';

      if (shouldRestoreFocus && lastFocusedElement) {
        lastFocusedElement.focus({ preventScroll: true });
      }

      shouldRestoreFocus = false;
      lastFocusedElement = null;
    };

    articleImages.forEach((imageElement) => {
      imageElement.classList.add('modal-enabled-image');
      imageElement.tabIndex = 0;
      imageElement.setAttribute('aria-haspopup', 'dialog');
      imageElement.addEventListener('click', () =>
        openModal(imageElement, false)
      );
      imageElement.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(imageElement, true);
        }
      });
    });

    closeButton.addEventListener('click', closeModal);
    prevButton.addEventListener('click', () =>
      showImageAtIndex(currentImageIndex - 1)
    );
    nextButton.addEventListener('click', () =>
      showImageAtIndex(currentImageIndex + 1)
    );
    backdrop.addEventListener('click', closeModal);

    const handleDocumentKeydown = (e: KeyboardEvent) => {
      if (!isModalOpen()) {
        return;
      }

      if (e.key === 'Escape') {
        closeModal();
        return;
      }

      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        showImageAtIndex(currentImageIndex - 1);
        return;
      }

      if (e.key === 'ArrowRight') {
        e.preventDefault();
        showImageAtIndex(currentImageIndex + 1);
        return;
      }

      if (e.key !== 'Tab') {
        return;
      }

      const focusableElements = getFocusableElements();
      if (focusableElements.length === 0) {
        e.preventDefault();
        closeButton.focus({ preventScroll: true });
        return;
      }

      const firstFocusable = focusableElements[0];
      const lastFocusable = focusableElements[focusableElements.length - 1];
      const activeElement = document.activeElement;

      if (e.shiftKey && activeElement === firstFocusable) {
        e.preventDefault();
        lastFocusable.focus({ preventScroll: true });
        return;
      }

      if (!e.shiftKey && activeElement === lastFocusable) {
        e.preventDefault();
        firstFocusable.focus({ preventScroll: true });
      }
    };

    document.addEventListener('keydown', handleDocumentKeydown);
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageModal);
  } else {
    initImageModal();
  }
</script>

<style>
  .image-modal {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    height: 100lvh;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    overscroll-behavior: contain;
    padding: max(1rem, env(safe-area-inset-top, 0px))
      max(1rem, env(safe-area-inset-right, 0px))
      max(1rem, env(safe-area-inset-bottom, 0px))
      max(1rem, env(safe-area-inset-left, 0px));
  }

  .image-modal.active {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.9);
    cursor: pointer;
  }

  :root[data-theme='light'] .modal-backdrop {
    background-color: rgba(0, 0, 0, 0.82);
  }

  .modal-content {
    position: relative;
    z-index: 10000;
    max-width: 90vw;
    max-height: 90vh;
    max-height: 90dvh;
    max-height: 90lvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;

    @media (max-width: 684px) {
      max-width: 95vw;
      max-height: 90vh;
      max-height: 90dvh;
      max-height: 90lvh;
    }
  }

  .modal-close {
    position: fixed;
    top: max(0.75rem, env(safe-area-inset-top, 0px));
    right: max(0.75rem, env(safe-area-inset-right, 0px));
    background: none;
    border: none;
    color: white;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
    opacity: 0.8;

    @media (max-width: 684px) {
      font-size: 2rem;
      width: 44px;
      height: 44px;
    }
  }

  .modal-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: white;
    width: auto;
    height: auto;
    padding: 0.25rem 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.25rem;
    line-height: 1;
    cursor: pointer;
    z-index: 10001;
    opacity: 0.85;
    transition: opacity 0.2s;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .modal-nav:hover {
    opacity: 1;
  }

  .modal-nav:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .modal-nav[hidden] {
    display: none;
  }

  .modal-nav-prev {
    left: max(0.75rem, env(safe-area-inset-left, 0px));
  }

  .modal-nav-next {
    right: max(0.75rem, env(safe-area-inset-right, 0px));
  }

  .modal-close:hover {
    opacity: 1;
  }

  .modal-close:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  article img.modal-enabled-image {
    cursor: zoom-in;
  }

  .modal-image {
    max-width: 100%;
    max-height: calc(90vh - 5rem);
    max-height: calc(90dvh - 5rem);
    max-height: calc(90lvh - 5rem);
    margin: 0;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);

    @media (max-width: 684px) {
      max-height: calc(90vh - 5rem);
      max-height: calc(90dvh - 5rem);
      max-height: calc(90lvh - 5rem);
    }
  }

  .modal-caption {
    color: white;
    text-align: center;
    font-size: 0.9rem;
    max-width: 100%;
    padding: 0.5rem 1rem;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 4px;

    @media (max-width: 684px) {
      font-size: 0.8rem;
      padding: 0.4rem 0.8rem;
    }
  }
</style>
