---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { cover, title, category, role } = project.data;
---

<div class="gallery">
  <div class="gallery-main">
    <Image src={cover} alt={`${title} — project screenshot`} width={1200} />
  </div>
</div>

<style>
  .gallery-main {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .gallery-main :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    margin: 0;
  }
  .gallery-badges {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    display: flex;
    gap: var(--space-2);
  }
  .gallery-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--surface-canvas) 88%, transparent);
    border: 1px solid var(--border-subtle);
    color: var(--color-text-secondary);
    backdrop-filter: blur(4px);
  }
  .gallery-badge--accent {
    color: var(--accent-strong);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
  }
</style>
