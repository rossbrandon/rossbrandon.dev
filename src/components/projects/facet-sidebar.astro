---
import { ChevronDownIcon } from '@components/icons';

interface FacetOption {
  value: string;
  count: number;
}

interface FacetGroup {
  key: string;
  label: string;
  options: FacetOption[];
}

interface Props {
  facets: FacetGroup[];
}

const { facets } = Astro.props;
---

<aside class="facets" id="facets" data-collapsed="true">
  <button
    class="facets-toggle"
    type="button"
    id="facets-toggle"
    aria-controls="facets"
    aria-expanded="false"
  >
    <span class="lbl">Filters</span>
    <ChevronDownIcon />
  </button>
  {
    facets.map((group) => (
      <div class="facet" data-facet={group.key} data-open="true">
        <button class="facet-head" type="button">
          <h3>{group.label}</h3>
          <ChevronDownIcon />
        </button>
        <div class="facet-body">
          {group.options.map((opt) => (
            <label class="facet-opt">
              <input type="checkbox" name={group.key} value={opt.value} />
              <span class="lbl">{opt.value}</span>
              <span class="ct">{opt.count}</span>
            </label>
          ))}
        </div>
      </div>
    ))
  }
</aside>

<style>
  .facets {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-self: start;
    min-width: 0;
  }
  @media (min-width: 961px) {
    .facets {
      position: sticky;
      top: calc(60px + var(--space-6));
      max-height: calc(100vh - 60px - var(--space-8));
      overflow-y: auto;
      padding-right: var(--space-2);
    }
  }
  .facets::-webkit-scrollbar {
    width: 6px;
  }
  .facets::-webkit-scrollbar-thumb {
    background: var(--border-subtle);
    border-radius: 3px;
  }

  .facets-toggle {
    display: none;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    box-sizing: border-box;
    background: var(--surface-default);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
    -webkit-appearance: none;
    appearance: none;
  }
  .facets-toggle svg {
    width: 14px;
    height: 14px;
    color: var(--color-text-muted);
    transition: transform var(--duration-fast);
  }
  .facets-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  @media (max-width: 960px) {
    .facets-toggle {
      display: flex;
    }
    .facets[data-collapsed='true'] .facet {
      display: none;
    }
    .facet:first-of-type .facet-head {
      padding-top: var(--space-3);
    }
  }

  .facet {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .facet:first-of-type {
    padding-top: 0;
  }
  .facet:last-of-type {
    border-bottom: 0;
  }

  .facet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    padding: 0;
    background: none;
    border: 0;
    width: 100%;
    font-family: var(--font-sans);
    transition: color var(--duration-fast);
  }
  .facet-head h3 {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
    margin: 0;
    transition: color var(--duration-fast);
  }
  .facet-head:hover h3 {
    color: var(--accent);
  }
  .facet-head svg {
    width: 14px;
    height: 14px;
    color: var(--color-text-muted);
    transition: transform var(--duration-fast);
  }
  .facet[data-open='false'] .facet-head svg {
    transform: rotate(-90deg);
  }
  .facet[data-open='false'] .facet-body {
    display: none;
  }

  .facet-body {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: var(--space-3);
  }

  .facet-opt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--duration-fast);
  }
  .facet-opt:hover {
    color: var(--accent);
  }
  .facet-opt input {
    accent-color: var(--accent);
    margin: 0;
    flex-shrink: 0;
  }
  .facet-opt .lbl {
    flex: 1;
  }
  .facet-opt .ct {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .facet-opt input:checked ~ .lbl {
    color: var(--color-text-primary);
    font-weight: var(--weight-medium);
  }
</style>

<script>
  const toggle = document.getElementById('facets-toggle');
  const facets = document.getElementById('facets');

  toggle?.addEventListener('click', () => {
    const collapsed = facets?.getAttribute('data-collapsed') !== 'false';
    facets?.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
    toggle.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
  });
</script>
