---
import Logo from './logo.astro';
import Navigation from './navigation.astro';
import ThemeToggle from './theme-toggle.astro';
---

<header>
  <div class="inner">
    <Logo />
    <div class="right">
      <Navigation />
      <div class="theme-toggle not-selectable">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: var(--space-5);
    background: var(--surface-default);

    @media (max-width: 684px) {
      padding: var(--space-4) var(--space-5);
    }
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
    width: var(--container-prose);
    max-width: 100%;
  }

  .right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-4);

    @media (max-width: 684px) {
      flex-direction: row-reverse;
    }
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    cursor: pointer;
  }

  .not-selectable {
    user-select: none;
  }
</style>
