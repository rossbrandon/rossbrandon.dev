---
interface Props {
  href: string;
  target?: string;
  rel?: string;
  class?: string;
}

const { href, target, rel, class: className } = Astro.props;
---

<a href={href} target={target} rel={rel} class:list={['button', className]}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.375rem;
    padding: 0.4rem 0.85rem;
    color: var(--color-text-primary);
    background-color: var(--surface-subtle);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    border: 1px solid var(--border-default);
    border-radius: 0.5rem;
    box-shadow: var(--shadow-sm);
    transition:
      background 0.15s ease,
      box-shadow 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .button:hover {
    background-color: var(--accent);
    color: var(--accent-on);
    border-color: var(--accent);
    text-decoration: none;
    box-shadow: var(--shadow-md);
  }

  .button :global(svg) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
</style>
