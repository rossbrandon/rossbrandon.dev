---
import { ReadingTime } from '@components/posts';

import Base from './base.astro';

const {
  frontmatter,
  title: propTitle,
  pageTitle: propPageTitle,
  description: propDescription,
  ogType,
  publishedDate,
  readingTime,
} = Astro.props;
const title = propTitle ?? frontmatter?.title;
const pageTitle = propPageTitle ?? frontmatter?.pageTitle ?? title;
const description = propDescription ?? frontmatter?.description;
---

<Base
  pageTitle={pageTitle}
  description={description}
  ogType={ogType}
  publishedDate={publishedDate}
>
  <slot name="head" slot="head" />
  <main class="page-content">
    <article>
      <header>
        {
          readingTime && (
            <p class="reading-time">
              <ReadingTime readingTime={readingTime} />
            </p>
          )
        }
        <h1>{title}</h1>
      </header>
      <slot />
    </article>
  </main>
</Base>

<style>
  .page-content {
    width: var(--content-width);
    margin: 0 auto;
    padding-top: 2rem;
    padding-bottom: 3rem;
    text-align: left;

    @media (max-width: 684px) {
      width: 100%;
      padding: 1rem 2rem;
    }
  }

  article {
    line-height: 1.6;
  }

  header {
    margin-bottom: 2rem;
    text-align: left;
  }

  h1 {
    font-size: 2.5rem;

    @media (max-width: 684px) {
      font-size: 2rem;
    }
  }

  time {
    color: var(--color-secondary);
    font-size: 0.9rem;
  }
</style>
