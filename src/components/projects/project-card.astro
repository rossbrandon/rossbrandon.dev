---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, category, year, role, tech, cover } = project.data;
const href = `/projects/${project.id}`;
---

<a
  href={href}
  class="project-card"
  data-astro-prefetch
  data-category={category}
  data-tech={tech.join(',')}
  data-role={role}
  data-year={year}
  data-title={title.toLowerCase()}
  data-desc={description.toLowerCase()}
>
  <div class="project-cover">
    <Image
      src={cover}
      alt={`${title} cover`}
      width={640}
      height={400}
      loading="lazy"
    />
    <div class="project-badges">
      <span class="project-badge project-badge--cat">{category}</span>
    </div>
  </div>
  <div class="project-body">
    <div class="project-eyebrow">
      <span class="role">{role}</span>
      <span class="year">{year}</span>
    </div>
    <h3 class="project-title">{title}</h3>
    <p class="project-desc">{description}</p>
    <div class="project-tech">
      {tech.map((t) => <span class="t">{t}</span>)}
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-default);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-fast);
    text-decoration: none;
    color: inherit;
  }
  .project-card:hover {
    border-color: var(--border-strong);
    text-decoration: none;
  }
  .project-card:hover .project-title {
    color: var(--accent);
  }

  .project-cover {
    aspect-ratio: 16 / 10;
    background: var(--surface-subtle);
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
  }
  .project-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
  }
  .project-badges {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    gap: var(--space-2);
  }
  .project-badge {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--surface-canvas) 88%, transparent);
    border: 1px solid var(--border-subtle);
    color: var(--color-text-secondary);
    backdrop-filter: blur(4px);
  }
  .project-badge--cat {
    color: var(--accent-strong);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
  }
  .project-badge--open {
    background: var(--accent);
    color: var(--accent-on);
    border-color: var(--accent);
  }

  .project-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }
  .project-eyebrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .project-eyebrow .role {
    color: var(--color-text-secondary);
  }
  .project-title {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    transition: color var(--duration-fast);
  }
  .project-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-snug);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .project-tech .t {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    padding: 2px 6px;
    background: var(--surface-subtle);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }
</style>
