---
import { Card } from '@components/card';
import Base from '@layouts/base.astro';
import { getReadingData } from '@utils/content';

const readingData = await getReadingData();
---

<Base
  pageTitle="Reading List :: Ross Brandon"
  description="Books and articles Ross Brandon has been reading."
>
  <main class="reading-wrap">
    <h1>Things I've been reading</h1>
    <div class="reading-cards">
      {readingData.map((reading) => <Card {...reading.data} />)}
    </div>
  </main>
</Base>

<style>
  .reading-wrap {
    max-width: var(--container-max);
    width: 100%;
    margin: 0 auto;
    padding: var(--space-8) var(--space-8) var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    text-align: left;
  }
  @media (max-width: 760px) {
    .reading-wrap {
      padding: var(--space-6) var(--space-5) var(--space-10);
    }
  }

  h1 {
    margin: 0;
    text-align: left;

    @media (max-width: 684px) {
      font-size: var(--text-2xl);
    }
  }

  .reading-cards {
    max-width: var(--container-wide);
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(320px, 1fr));
    gap: var(--space-6);
    align-items: stretch;
    grid-auto-rows: auto;

    @media (max-width: 684px) {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
