---
import { Image } from 'astro:assets';
import { Button } from '@components/button';
import { Tag } from '@components/tag';
import { getYearFromDate } from '@utils/date';

const { title, author, cover, link, status, tags, finishedDate } = Astro.props;

const statusText = (() => {
  switch (status) {
    case 'Finished':
      return `Read in ${getYearFromDate(finishedDate)}`;
    case 'Reading':
      return 'Currently Reading';
    case 'To Read':
      return 'To Read';
    default:
      return '';
  }
})();

const statusClass = (() => {
  switch (status) {
    case 'Finished':
      return 'status-finished';
    case 'Reading':
      return 'status-reading';
    case 'To Read':
      return 'status-to-read';
    default:
      return '';
  }
})();
---

<div class="card">
  <div class="cover-container">
    <Image src={cover} alt={title} width={400} height={600} loading="eager" />
  </div>
  <div class="card-content">
    <div class="card-info">
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="title-link"
      >
        <h2>{title}</h2>
      </a>
      <p class="author">{author}</p>
      {status && <p class={`reading-status ${statusClass}`}>{statusText}</p>}
    </div>
    <div class="card-meta">
      <div class="tags">
        {tags.map((tag: string) => <Tag>{tag}</Tag>)}
      </div>
      <Button href={link} target="_blank" rel="noopener noreferrer">
        Read more &rarr;
      </Button>
    </div>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.25rem;
    background-color: var(--surface-default);
    padding: 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    box-shadow: var(--shadow-xs);
    transition: box-shadow 0.25s ease;
    height: auto;

    @media (max-width: 900px) {
      gap: 0.875rem;
      padding: 0.875rem;
    }

    @media (max-width: 684px) {
      gap: 0.75rem;
      padding: 0.75rem;
    }
  }

  .cover-container {
    width: 11rem;
    min-width: 11rem;
    overflow: hidden;
    border-radius: 0.5rem;
    flex-shrink: 0;

    @media (max-width: 900px) {
      width: 7rem;
      min-width: 7rem;
    }

    @media (max-width: 684px) {
      width: 6.25rem;
      min-width: 6.25rem;
    }
  }

  .cover-container :global(picture),
  .cover-container :global(img) {
    width: 100% !important;
    height: auto !important;
    display: block;
    object-fit: cover;
    object-position: center;
    margin: 0;
    border-radius: inherit;
    transition: transform 0.3s ease;
  }

  .card:hover .cover-container :global(img) {
    transform: scale(1.01);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    align-items: flex-start;
    align-self: stretch;
    flex: 1;
    justify-content: space-between;
    min-height: 100%;

    @media (max-width: 900px) {
      gap: 0.375rem;
    }
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0;
    line-height: 1.3;
    text-align: left;

    @media (max-width: 684px) {
      font-size: 1.2rem;
    }
  }

  .title-link {
    text-decoration: none;
    color: inherit;
  }

  .title-link:hover {
    text-decoration: underline;
  }

  .author {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0.15rem 0 0.25rem 0;
    text-align: left;
  }

  .reading-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 800;
    font-style: italic;
    margin: 0;
    text-align: left;
    letter-spacing: 0.025em;
    line-height: 1.2;
  }

  .reading-status::before {
    content: '';
    flex: 0 0 auto;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .status-finished {
    color: var(--success-fg);
  }

  .status-reading {
    color: var(--info-fg);
  }

  .status-to-read {
    color: var(--color-text-muted);
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
    width: 100%;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
</style>
